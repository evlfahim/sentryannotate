{
  "name": "sentryannotate",
  "version": "1.0.0",
  "private": true,
  "description": "A modular, desktop-first screenshot annotation toolkit",
  "workspaces": [
    "packages/core",
    "packages/ui"
  ],
  "scripts": {
    "build:core": "tsc -p packages/core/tsconfig.json",
    "build:app": "tsc -p tsconfig.app.json",
    "build": "npm run build:core && npm run build:app",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "electron": "^28.0.0",
    "@types/node": "^20.11.0",
    "vitest": "^1.2.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/parser": "^6.20.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0"
  },
  "dependencies": {
    "sharp": "^0.33.2"
  },
  "license": "MIT"
}
